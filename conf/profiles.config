/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    LOMA: Nextflow profiles config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

profiles {
  standard {
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
        docker.enabled         = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
    }
  }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
        docker.enabled         = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
    }
    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
    }
    mamba {
        conda.enabled          = true
        conda.useMamba         = true
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }

    // Slurm HPC cluster profile
    slurm {
        process.executor        = 'slurm'
        process.queue           = 'normal'
        process.clusterOptions  = null

        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false

        // Slurm-specific resource settings
        params.max_memory       = '500.GB'
        params.max_cpus         = 128
        params.max_time         = '168.h'

        // Slurm job submission settings
        process.cache           = 'lenient'
        process.errorStrategy   = { task.exitStatus in [143,137,104,134,139,140] ? 'retry' : 'finish' }
        process.maxRetries      = 2
    }

    // RTX 4070 Ultra workstation profile (22 cores, 64GB RAM, 1x RTX 4070)
    rtx4070 {
        singularity.enabled     = true
        singularity.autoMounts  = true
        singularity.runOptions  = '--nv'  // Enable NVIDIA GPU support
        conda.enabled           = false
        docker.enabled          = false

        params.max_memory       = '60.GB'
        params.max_cpus         = 20  // Leave 2 cores for system
        params.max_time         = '240.h'

        // Parabricks GPU acceleration settings
        // Set to false if Parabricks is not available or licensed
        params.use_parabricks   = true
        params.parabricks_container = 'nvcr.io/nvidia/clara/clara-parabricks:4.3.2-1'

        // GPU-enabled processes
        process {
            withLabel:process_gpu {
                accelerator = 1
                containerOptions = { workflow.containerEngine == "singularity" ? '--nv':
                    ( workflow.containerEngine == "docker" ? '--gpus all': null ) }
            }

            // Enable Parabricks GPU acceleration for minimap2 processes
            withName: 'MINIMAP2_ALIGN|MINIMAP2_ALIGN_1|MINIMAP2_ALIGN_BIN_.*' {
                ext.use_parabricks_gpu = params.use_parabricks
                container = params.use_parabricks ? params.parabricks_container : null
                accelerator = params.use_parabricks ? 1 : null
                containerOptions = { params.use_parabricks && workflow.containerEngine == "singularity" ? '--nv':
                    ( params.use_parabricks && workflow.containerEngine == "docker" ? '--gpus all': null ) }
            }
        }
    }

    // NVIDIA DGX Station A100 profile (128 cores, 512GB RAM, 4x A100 GPUs)
    dgx_a100 {
        singularity.enabled     = true
        singularity.autoMounts  = true
        singularity.runOptions  = '--nv'  // Enable NVIDIA GPU support
        conda.enabled           = false
        docker.enabled          = false

        params.max_memory       = '480.GB'  // Leave some for system
        params.max_cpus         = 120  // Leave some cores for system
        params.max_time         = '240.h'

        // Parabricks GPU acceleration settings
        // Set to false if Parabricks is not available or licensed
        params.use_parabricks   = true
        params.parabricks_container = 'nvcr.io/nvidia/clara/clara-parabricks:4.3.2-1'

        // Optimized resource allocation for DGX A100
        process {
            // Override default process resources for high-performance system
            cpus   = { check_max( 2    * task.attempt, 'cpus'   ) }
            memory = { check_max( 16.GB * task.attempt, 'memory' ) }

            withLabel:process_single {
                cpus   = { check_max( 2                   , 'cpus'    ) }
                memory = { check_max( 12.GB * task.attempt, 'memory'  ) }
            }
            withLabel:process_low {
                cpus   = { check_max( 4      * task.attempt, 'cpus'    ) }
                memory = { check_max( 24.GB  * task.attempt, 'memory'  ) }
            }
            withLabel:process_medium {
                cpus   = { check_max( 24     * task.attempt, 'cpus'    ) }
                memory = { check_max( 64.GB  * task.attempt, 'memory'  ) }
            }
            withLabel:process_high {
                cpus   = { check_max( 60     * task.attempt, 'cpus'    ) }
                memory = { check_max( 200.GB * task.attempt, 'memory'  ) }
            }
            withLabel:process_long {
                time   = { check_max( 48.h   * task.attempt, 'time'    ) }
            }

            // GPU-enabled processes
            withLabel:process_gpu {
                accelerator = 1
                containerOptions = { workflow.containerEngine == "singularity" ? '--nv':
                    ( workflow.containerEngine == "docker" ? '--gpus all': null ) }
            }

            // Enable Parabricks GPU acceleration for minimap2 processes
            withName: 'MINIMAP2_ALIGN|MINIMAP2_ALIGN_1|MINIMAP2_ALIGN_BIN_.*' {
                ext.use_parabricks_gpu = params.use_parabricks
                container = params.use_parabricks ? params.parabricks_container : null
                accelerator = params.use_parabricks ? 1 : null
                containerOptions = { params.use_parabricks && workflow.containerEngine == "singularity" ? '--nv':
                    ( params.use_parabricks && workflow.containerEngine == "docker" ? '--gpus all': null ) }
            }
        }
    }

    // Slurm with GPU support (for HPC clusters with GPU nodes)
    slurm_gpu {
        process.executor        = 'slurm'
        process.queue           = 'gpu'
        process.clusterOptions  = '--gres=gpu:1'

        singularity.enabled     = true
        singularity.autoMounts  = true
        singularity.runOptions  = '--nv'
        conda.enabled           = false
        docker.enabled          = false

        params.max_memory       = '500.GB'
        params.max_cpus         = 128
        params.max_time         = '168.h'

        // Parabricks GPU acceleration settings
        // Set to false if Parabricks is not available or licensed on your HPC
        params.use_parabricks   = true
        params.parabricks_container = 'nvcr.io/nvidia/clara/clara-parabricks:4.3.2-1'

        process {
            cache                = 'lenient'
            errorStrategy        = { task.exitStatus in [143,137,104,134,139,140] ? 'retry' : 'finish' }
            maxRetries           = 2

            withLabel:process_gpu {
                accelerator      = 1
                clusterOptions   = '--gres=gpu:1'
                containerOptions = { workflow.containerEngine == "singularity" ? '--nv':
                    ( workflow.containerEngine == "docker" ? '--gpus all': null ) }
            }

            // Enable Parabricks GPU acceleration for minimap2 processes
            withName: 'MINIMAP2_ALIGN|MINIMAP2_ALIGN_1|MINIMAP2_ALIGN_BIN_.*' {
                ext.use_parabricks_gpu = params.use_parabricks
                container = params.use_parabricks ? params.parabricks_container : null
                accelerator = params.use_parabricks ? 1 : null
                clusterOptions = params.use_parabricks ? '--gres=gpu:1' : null
                containerOptions = { params.use_parabricks && workflow.containerEngine == "singularity" ? '--nv':
                    ( params.use_parabricks && workflow.containerEngine == "docker" ? '--gpus all': null ) }
            }
        }
    }
}
